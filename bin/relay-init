#!/usr/bin/env bash
#
# relay-init — prepara un progetto dev-flow al lavoro notturno.
#
# Da lanciare dentro la cartella del progetto, dopo il giorno 0 (vedi
# docs/day-0.md). Crea il repo GitHub privato, committa la configurazione che
# permette alla sandbox cloud di caricare le skill dev-flow, e stampa la
# configurazione da incollare nella form della routine.
#
# Idempotente: rilanciarlo su un progetto gia' inizializzato non rompe nulla.
#
#   relay-init           verifica, crea il repo, committa, pusha
#   relay-init --check   verifica soltanto, non tocca nulla

set -euo pipefail

CHECK_ONLY=false
[ "${1:-}" = "--check" ] && CHECK_ONLY=true

GH_OWNER="${NIGHTLY_GH_OWNER:-lukedj78}"
MARKETPLACE_REPO="${NIGHTLY_MARKETPLACE_REPO:-lukedj78/dev-flow}"
SLUG=$(basename "$PWD")

die() { printf '\033[31m✗\033[0m %s\n' "$1" >&2; exit 1; }
ok()  { printf '\033[32m✓\033[0m %s\n' "$1"; }
warn(){ printf '\033[33m!\033[0m %s\n' "$1"; }

# ─── Prerequisiti ────────────────────────────────────────────────────────────
# Falliamo qui, forte e chiaro, invece di scoprire alle tre di notte che
# mancava qualcosa.

command -v gh >/dev/null || die "gh non installato — brew install gh"
gh auth status >/dev/null 2>&1 || die "gh non autenticato — gh auth login"

[ -d .git ] || die "non e' un repo git — lancia 'git init' prima"

[ -f .workflow/meta.json ] \
  || die "manca .workflow/meta.json — il giorno 0 non e' stato fatto (docs/day-0.md)"

PHASE=$(python3 -c "import json;print(json.load(open('.workflow/meta.json'))['phase'])")
case "$PHASE" in
  empty|idea_captured)
    die "phase='$PHASE': non c'e' abbastanza per lavorare di notte.
     Serve almeno un PRD e dei task. Vedi docs/day-0.md" ;;
esac

# Il contratto dev-flow colloca DESIGN.md dentro .workflow/, non in docs/.
if [ ! -f .workflow/DESIGN.md ]; then
  warn "manca .workflow/DESIGN.md — la prima notte scaffoldera' senza direzione visiva.
     Consigliato: /image-to-design-md o /figma-to-design-md prima di procedere."
fi

if [ ! -f .workflow/tasks.md ]; then
  warn "manca .workflow/tasks.md — senza quello non c'e' niente da mettere in coda.
     Lancia /prd-to-tasks nel progetto prima di creare la routine."
fi

ok "prerequisiti verificati (phase='$PHASE')"

# ─── Prerequisiti del ciclo chiuso ───────────────────────────────────────────
# Non bloccano relay-init: il repo si prepara lo stesso. Ma senza di loro il
# ciclo si accende e gira a vuoto, e gira a vuoto in silenzio — che e' peggio.

if git remote get-url origin >/dev/null 2>&1; then
  # Attenzione a come si legge questa risposta: su 403 `gh api` stampa comunque
  # un JSON, quindi "output non vuoto" NON significa "protetta". Va guardato lo
  # stato HTTP, non il contenuto.
  PROT_BODY=$(gh api "repos/$GH_OWNER/$SLUG/branches/main/protection" 2>&1 || true)
  case "$PROT_BODY" in
    *'"status":"403"'*|*'Upgrade to GitHub Pro'*)
      warn "protezione dei branch NON disponibile: repo privato su piano free.
     GitHub la offre solo su repo pubblici o dal piano Pro in su.
     Il ciclo funziona lo stesso, con un livello di sicurezza in meno:
     il revisore controlla la CI da se' (disciplina) invece che GitHub
     rifiutare il merge (imposizione). La rete di revert resta, ed e'
     esattamente il caso per cui esiste.
     Per avere l'imposizione: repo pubblico, oppure GitHub Pro." ;;
    *'"status":"404"'*|*'Branch not protected'*)
      warn "main NON protetta — il revisore potra' mergiare con la CI rossa.
     Settings → Rules → New branch ruleset su main:
       SI  Require status checks to pass → verify
       NO  Required approvals — le routine girano con la TUA identita' e
           GitHub vieta di approvare un proprio PR: il ciclo diventerebbe
           impossibile da chiudere
       SI  Bypass list → Repository admin, altrimenti l'Action di revert
           non puo' pushare" ;;
    *)
      REQUIRED=$(printf '%s' "$PROT_BODY" \
        | python3 -c 'import json,sys; print(", ".join(json.load(sys.stdin).get("required_status_checks",{}).get("contexts",[])) or "nessuno")' 2>/dev/null \
        || echo "?")
      ok "main protetta, check richiesti: $REQUIRED" ;;
  esac

  DELBR=$(gh api "repos/$GH_OWNER/$SLUG" --jq .delete_branch_on_merge 2>/dev/null || echo "?")
  if [ "$DELBR" = "true" ]; then
    ok "i branch si cancellano al merge (il lock si rilascia da solo)"
  else
    warn "delete_branch_on_merge=false — i lock resteranno appesi.
     Il lock e' la ref del branch: se sopravvive al merge, quella issue
     resta presa per sempre. Si gira con:
       gh api repos/$GH_OWNER/$SLUG -X PATCH -f delete_branch_on_merge=true"
  fi
fi

if $CHECK_ONLY; then
  echo "--check: nessuna modifica fatta."
  exit 0
fi

# ─── La configurazione che serve alla sandbox ────────────────────────────────
# Le skill dev-flow vivono in ~/.claude/skills/, che la sandbox cloud non vede:
# clona solo il repo. La documentazione indica enabledPlugins in
# .claude/settings.json come il modo di caricarle nelle sessioni cloud.

mkdir -p .claude
if [ -f .claude/settings.json ] && grep -q dev-flow .claude/settings.json; then
  ok ".claude/settings.json gia' configurato"
else
  cat > .claude/settings.json <<JSON
{
  "extraKnownMarketplaces": {
    "dev-flow": { "source": { "source": "github", "repo": "$MARKETPLACE_REPO" } }
  },
  "enabledPlugins": { "dev-flow@dev-flow": true }
}
JSON
  ok ".claude/settings.json scritto"
fi

# ─── Il repo remoto ──────────────────────────────────────────────────────────

if git remote get-url origin >/dev/null 2>&1; then
  ok "remote origin gia' presente: $(git remote get-url origin)"
else
  gh repo create "$GH_OWNER/$SLUG" --private --source=. --remote=origin
  ok "creato $GH_OWNER/$SLUG (privato)"
fi

BRANCH=$(git symbolic-ref --short HEAD)

if [ -n "$(git status --porcelain)" ]; then
  git add .claude/settings.json .workflow
  git add -A
  git commit -qm "chore: il progetto impara a lavorare di notte"
  ok "commit creato"
fi

git push -qu origin "$BRANCH"
ok "pushato su origin/$BRANCH"

# ─── Cosa incollare nella form ───────────────────────────────────────────────

NIGHT_FLOW="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"

cat <<EOF

────────────────────────────────────────────────────────────────
  Il repo e' pronto. Mancano la coda e le routine.
────────────────────────────────────────────────────────────────

  1. La coda — trasforma i task in issue GitHub:

       $NIGHT_FLOW/bin/tasks-to-issues --dry-run
       $NIGHT_FLOW/bin/tasks-to-issues

  2. Le due Action — copiale nel progetto:

       cp $NIGHT_FLOW/templates/revert-on-broken-main.yml .github/workflows/

     La CI (verify.yml) e' del progetto e dev'esserci gia'.

  3. Le routine — https://claude.ai/code/routines → New routine

     Tutte e cinque: Repository $GH_OWNER/$SLUG, Environment nightly,
     Modello Sonnet, e Connectors NESSUNO — l'API ne attacca alcuni
     da sola, vanno tolti a mano e RICONTROLLATI dopo il salvataggio.

     ┌─ $SLUG — autore ──────────────── ACCENDI QUESTA PER PRIMA
     │  Trigger   Schedule → daily, 02:00
     │            + GitHub → pull_request closed, is merged = true
     │  Prompt    $NIGHT_FLOW/routine/prompt.md
     └─

     ┌─ $SLUG — revisore ────────────── quando l'autore e' rodato
     │  Trigger   GitHub → pull_request: opened, reopened, synchronize
     │  Filtro    Labels  is not one of  needs-human
     │  Prompt    $NIGHT_FLOW/routine/review-prompt.md
     └─

     ┌─ $SLUG — correttore ──────────── NON insieme al revisore
     │  Trigger   GitHub → pull_request (reagisce alla review)
     │  Filtro    Labels  is not one of  needs-human
     │  Prompt    $NIGHT_FLOW/routine/fix-prompt.md
     └─

     ┌─ $SLUG — documentatore ───────── dopo il primo merge automatico
     │  Trigger   GitHub → pull_request closed, is merged = true
     │  Filtro    Head branch  does not start with  claude/docs-
     │  Prompt    $NIGHT_FLOW/routine/docs-prompt.md
     └─

     ┌─ $SLUG — spazzino ────────────── per ultima, se vedi PR fermi
     │  Trigger   Schedule → hourly
     │  Prompt    $NIGHT_FLOW/routine/sweeper-prompt.md
     └─

     I DUE FILTRI NON SONO FACOLTATIVI:
       - senza "not one of needs-human", un PR uscito dal ciclo
         ci rientra da solo e non ne esce piu'
       - senza "does not start with claude/docs-", il documentatore
         risponde ai propri PR: apre un PR, il merge lo risveglia,
         ne apre un altro. Il tetto giornaliero finisce in un'ora.

  4. Premi "Run now" sull'autore e GUARDA il run. Il setup script
     sbaglia sempre qualcosa la prima volta.

     Poi accendi UNA routine per volta, nell'ordine dei riquadri, e
     guarda cosa fa prima di passare alla successiva. L'ordine non e'
     estetico: vedi $NIGHT_FLOW/docs/cadences.md.

     Un'issue costa 4-6 run nel ciclo completo, non uno.

EOF
